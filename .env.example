# Copy this file to .env and fill in real values. Never commit .env.
# Everything is free unless marked PAID.

# ---------------------------------------------------------------- you ---
OWNER_NAME=Dario
TIMEZONE=Europe/Belgrade
CITY=Novi Sad
CITY_LAT=45.2671
CITY_LON=19.8335
DEFAULT_COUNTRY_CODE=381

# ---------------------------------------------------------------- LLM ---
# Main provider: gemini | groq | anthropic | ollama
LLM_PROVIDER=gemini
# Automatic switch when the main one fails or hits its free limit (comma list).
LLM_FALLBACKS=groq

# Google Gemini (free tier) - https://aistudio.google.com/apikey
# WARNING: the free tier may use your data for training and has rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier) - https://console.groq.com/keys
# Used as LLM fallback AND for speech-to-text (Whisper). Has rate limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

# Anthropic Claude (PAID, optional, best quality) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (free, runs on a PC - not on the phone)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# ---------------------------------------------------------------- HUD ---
# The HUD is Jarvis' main screen, opened in the phone's browser.
HUD_HOST=127.0.0.1
HUD_PORT=8765
# Leave empty: Jarvis generates a key and prints the HUD link at startup.
HUD_TOKEN=

# -------------------------------------------------------------- phone ---
# auto = use Termux:API when running on the phone
PHONE_MODE=auto
# After a missed call Jarvis drafts a follow-up message.
# auto = regular call -> SMS, WhatsApp call -> WhatsApp.  Or force: sms | whatsapp
FOLLOWUP_CHANNEL=auto
CALLS_POLL_SECONDS=20
SMS_POLL_SECONDS=30

# ----------------------------------------------------------- WhatsApp ---
# notifications = SAFE (default): reads WhatsApp notifications; after approval
#                 WhatsApp opens with the reply typed in, you tap Send.
# bridge        = UNOFFICIAL, fully automatic, CAN GET YOUR NUMBER BANNED. See README.
# off
WHATSAPP_MODE=notifications
WHATSAPP_POLL_SECONDS=10
INCLUDE_GROUPS=false
# Only for bridge mode:
WHATSAPP_NUMBER=
WHATSAPP_BRIDGE_URL=http://127.0.0.1:8766
WHATSAPP_BRIDGE_TOKEN=

# ------------------------------------------------- Gmail + Calendar ---
# One Google login for both. Setup steps in README ("Google: Gmail i kalendar").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ENABLED=false
GMAIL_QUERY=is:unread category:primary newer_than:2d
GMAIL_POLL_SECONDS=120
CALENDAR_ENABLED=false

# ---------------------------------------------------- daily rhythm ---
BRIEFING_TIME=08:00
# Empty = no evening summary
EVENING_SUMMARY_TIME=21:00
# Only queued notices in this window (reminders still get through). Empty = off.
QUIET_HOURS=23:00-08:00

# --------------------------------------------------------------- voice ---
# Serbian voices: sr-RS-NicholasNeural (male) / sr-RS-SophieNeural (female)
TTS_VOICE=sr-RS-NicholasNeural

# ---------------------------------------------- Telegram (optional) ---
# Secondary channel to reach Jarvis. Leave empty to disable.
# Token from @BotFather, your numeric ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=

# ------------------------------------------------------------ storage ---
DB_PATH=data/jarvis.db
BACKUP_KEEP=7
HISTORY_LIMIT=20
LOG_LEVEL=INFO
