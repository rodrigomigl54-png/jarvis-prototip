# Copy this file to .env and fill in real values. Never commit .env.

# --- Telegram bot (required) ---
# Get it from @BotFather on Telegram (/newbot).
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (ask @userinfobot). The bot answers ONLY this ID.
OWNER_TELEGRAM_ID=
# How Jarvis calls you
OWNER_NAME=Dario

# --- LLM provider: gemini | groq | anthropic | ollama ---
LLM_PROVIDER=gemini

# Google Gemini (free tier) - https://aistudio.google.com/apikey
# WARNING: free tier may use your data for training and has rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (free tier) - https://console.groq.com/keys
# WARNING: free tier has rate limits.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic Claude (PAID, optional) - https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Ollama (free, local) - https://ollama.com ; pick a model that supports tools
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- General ---
TIMEZONE=Europe/Belgrade
DB_PATH=data/jarvis.db
# How many recent chat messages Jarvis keeps as short-term context
HISTORY_LIMIT=20
LOG_LEVEL=INFO
